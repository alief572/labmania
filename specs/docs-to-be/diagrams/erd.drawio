        <mxCell id="erd_quotation_rel_qtn_qkc" edge="1" parent="1" source="erd_quotation_quotation_id" target="erd_quotation_qkc_id_quotation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToOne;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="143" /><mxPoint x="1070" y="2449" /></Array></mxGeometry></mxCell>
        <mxCell id="erd_quotation_qkc_txt" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;To be 10-11-2026&lt;/b&gt;: konfirmasi B2B &lt;b&gt;atas nama company&lt;/b&gt;, satu baris per quotation B2B (QTN-FR-31, QTN-FR-32). Diisi satu kali oleh PIC company lewat link; daftar peserta masuk &lt;i&gt;quotation_peserta&lt;/i&gt; dengan &lt;i&gt;sumber&lt;/i&gt; = company. Surat company bertanda tangan + cap (dengan lampiran daftar peserta) wajib diunggah: &lt;i&gt;surat_konfirmasi&lt;/i&gt; = path berkas, &lt;i&gt;surat_konfirmasi_nama&lt;/i&gt; = nama asli. Isian awal dari &lt;i&gt;customer&lt;/i&gt; (salinan, tidak mengubah Master Company)." vertex="1"><mxGeometry x="604" y="2734" width="364" height="100" as="geometry" /></mxCell>
