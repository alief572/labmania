        <mxCell id="erd_quotation_rf_updated_date_k" parent="erd_quotation_rf_updated_date" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;" value="" vertex="1"><mxGeometry width="44" height="26" as="geometry"><mxRectangle width="44" height="26" as="alternateBounds" /></mxGeometry></mxCell>
