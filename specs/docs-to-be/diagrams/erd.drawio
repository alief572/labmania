        <mxCell id="erd_master_program_mpp_urutan_n" parent="erd_master_program_mpp_urutan" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" value="urutan" vertex="1"><mxGeometry x="44" width="170" height="26" as="geometry"><mxRectangle width="170" height="26" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="erd_master_program_mpp_urutan_t" parent="erd_master_program_mpp_urutan" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontColor=#666666;fontSize=11;" value="INT (1 = Product utama)" vertex="1"><mxGeometry x="214" width="150" height="26" as="geometry"><mxRectangle width="150" height="26" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="erd_master_program_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;Catatan&lt;/b&gt;&lt;br&gt;• Kolom audit &lt;i&gt;created_by, created_date, updated_by, updated_date&lt;/i&gt; tidak digambar (pola &amp; tabel &lt;i&gt;logs&lt;/i&gt; di halaman ERD Activity Log).&lt;br&gt;• Tidak ada jenis Public/B2B, customer, tanggal, atau lokasi di Master Program (MP-FR-02).&lt;br&gt;• &lt;i&gt;status&lt;/i&gt;: draft → final, atau batal (fr-nfr-master-program.md bagian 6). Final/Batal terkunci. &lt;i&gt;confirmed_*&lt;/i&gt; = saat Final; &lt;i&gt;closed_*&lt;/i&gt; = saat Batal.&lt;br&gt;• &lt;i&gt;master_program_biaya&lt;/i&gt; menyimpan salinan item, satuan, harga (MP-FR-08). &lt;i&gt;id_rate&lt;/i&gt; NULL + &lt;i&gt;is_manual&lt;/i&gt; = 1 untuk biaya manual (MP-FR-09).&lt;br&gt;• HPP, profit, BEP dihitung dari baris biaya + header (bagian 8), tidak disimpan.&lt;br&gt;• Hijau = tabel milik modul Master Data (hanya dibaca); biru = tabel baru modul ini.&lt;br&gt;• Rekonsiliasi 13-11-2026: &lt;i&gt;jam_pembelajaran&lt;/i&gt; wajib (bilangan bulat &amp;gt; 0) di aplikasi untuk simpan dan Finalkan; kolom tetap NULL sampai data lama dibersihkan, NOT NULL dipasang di fase 7 (tanpa backfill)." vertex="1"><mxGeometry x="1530" y="60" width="464" height="330" as="geometry" /></mxCell>
        <mxCell id="erd_master_program_rel_paket_mp" edge="1" parent="1" source="erd_master_program_paket_produk_id" target="erd_master_program_mpp_id_paket_produk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="469" y="143" /><mxPoint x="469" y="80" /><mxPoint x="1070" y="80" /><mxPoint x="1070" y="195" /></Array></mxGeometry></mxCell>
        <mxCell id="erd_master_program_rel_mp_mpp" edge="1" parent="1" source="erd_master_program_master_program_id" target="erd_master_program_mpp_id_master_program" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERoneToMany;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="143" /><mxPoint x="1040" y="169" /></Array></mxGeometry></mxCell>
        <mxCell id="erd_master_program_mpp_txt" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;To be 09-11-2026&lt;/b&gt;: satu Master Program memuat &lt;b&gt;satu atau lebih Product&lt;/b&gt; lewat &lt;i&gt;master_program_produk&lt;/i&gt; (minimal 1; UNIQUE (id_master_program, id_paket_produk)). Kolom &lt;i&gt;master_program.id_paket_produk&lt;/i&gt; dihapus. Costing tetap satu: &lt;i&gt;master_program_biaya&lt;/i&gt; per Master Program, bukan per Product (MP-FR-02)." vertex="1"><mxGeometry x="1100" y="250" width="364" height="96" as="geometry" /></mxCell>
        <mxCell id="erd_master_program_rel_rate_mpb" edge="1" parent="1" source="erd_master_program_ms_rate_id" target="erd_master_program_master_program_biaya_id_rate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="469" y="563" /><mxPoint x="469" y="615" /></Array></mxGeometry></mxCell>
        <mxCell id="erd_master_program_rel_satuan_mpb" edge="1" parent="1" source="erd_master_program_ms_satuan_id" target="erd_master_program_master_program_biaya_id_satuan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="494" y="803" /><mxPoint x="494" y="693" /></Array></mxGeometry></mxCell>
        <mxCell id="erd_master_program_rel_mp_mpb" edge="1" parent="1" source="erd_master_program_master_program_id" target="erd_master_program_master_program_biaya_id_master_program" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="998" y="143" /><mxPoint x="998" y="589" /></Array></mxGeometry></mxCell>
