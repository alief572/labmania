ttom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontStyle=5;" vertex="1" parent="rev5_reschedule_id"><mxGeometry x="44" width="220" height="26" as="geometry" /></mxCell><mxCell id="rev5_reschedule_id_t" value="INT UNSIGNED AI" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontColor=#666666;fontSize=10;" vertex="1" parent="rev5_reschedule_id"><mxGeometry x="264" width="256" height="26" as="geometry" /></mxCell><mxCell id="rev5_rel_quote" parent="1" edge="1" source="rev5_quotation_id" target="rev5_quotation_revisi_id_quotation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;dashed=1;dashPattern=6 4;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="143" /><mxPoint x="600" y="169" /></Array></mxGeometry></mxCell><mxCell id="rev5_rel_reschedule" parent="1" edge="1" source="rev5_reschedule_id" target="rev5_quotation_revisi_id_reschedule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="393" /><mxPoint x="610" y="195" /></Array></mxGeometry></mxCell><mxCell id="rev5_note" value="&lt;b&gt;Kontrak fase 5&lt;/b&gt;&lt;br&gt;• UNIQUE(id_quotation,revisi); link_token_hash UNIQUE nullable. Snapshot menyimpan fakta cetak quotation dan SO versi lama, tanpa token mentah. Endpoint riwayat privat; tidak membaca ulang master yang berubah.&lt;br&gt;• Reschedule/evidence: halaman Penjualan Program. Konfirmasi ulang/Refund/peserta Keluar: halaman Quotation. Invoice Batal: halaman Invoice.&lt;br&gt;• Referensi signed legacy digambar putus-putus dan divalidasi server, FK unsigned ke tabel baru garis utuh. Audit users.id_user, bukan ms_user_karyawan.id.&lt;br&gt;• Empat kolom audit pada seluruh tabel baru. Alur reschedule/payment/keluar/Refund mengunci program terlebih dahulu; GET tidak melakukan pembatalan otomatis.&lt;br&gt;• Semua nomor dasar tetap; nomor tampil memakai revisi. SO baru memakai revisi quotation saat Deal." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="440" width="900" height="280" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>