voice_bukti_setor_updated_by_k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;" vertex="1" parent="inv4_invoice_bukti_setor_updated_by"><mxGeometry x="0" width="44" height="26" as="geometry" /></mxCell><mxCell id="inv4_invoice_bukti_setor_updated_by_n" value="updated_by" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="inv4_invoice_bukti_setor_updated_by"><mxGeometry x="44" width="220" height="26" as="geometry" /></mxCell><mxCell id="inv4_invoice_bukti_setor_updated_by_t" value="INT NULL → users.id_user" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontColor=#666666;fontSize=10;" vertex="1" parent="inv4_invoice_bukti_setor_updated_by"><mxGeometry x="264" width="256" height="26" as="geometry" /></mxCell><mxCell id="inv4_invoice_bukti_setor_updated_date" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;" vertex="1" parent="inv4_invoice_bukti_setor"><mxGeometry y="212" width="520" height="26" as="geometry" /></mxCell><mxCell id="inv4_invoice_bukti_setor_updated_date_k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;" vertex="1" parent="inv4_invoice_bukti_setor_updated_date"><mxGeometry x="0" width="44" height="26" as="geometry" /></mxCell><mxCell id="inv4_invoice_bukti_setor_updated_date_n" value="updated_date" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="inv4_invoice_bukti_setor_updated_date"><mxGeometry x="44" width="220" height="26" as="geometry" /></mxCell><mxCell id="inv4_invoice_bukti_setor_updated_date_t" value="DATETIME NULL" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontColor=#666666;fontSize=10;" vertex="1" parent="inv4_invoice_bukti_setor_updated_date"><mxGeometry x="264" width="256" height="26" as="geometry" /></mxCell><mxCell id="inv4_note_refs" value="&lt;b&gt;Relasi fisik dan logis&lt;/b&gt;&lt;br&gt;• Garis utuh = FK fisik: invoice.id_sales_order → sales_order.id; ketiga detail.id_invoice → invoice.id. Tabel transaksi InnoDB.&lt;br&gt;• Garis putus-putus = referensi COA logis: invoice.coa_penjualan dan invoice_jurnal.coa → coa_master.id. Kedua kolom ber-INDEX dan divalidasi server dalam transaksi.&lt;br&gt;• SHOW CREATE TABLE: coa_master ENGINE=MyISAM. FK InnoDB ke MyISAM ditolak (errno 1824); engine legacy tidak dikonversi. Tidak mengklaim constraint FK COA fisik.&lt;br&gt;• REF legacy signed: invoice.id_quotation → quotation.id; invoice.id_penjualan → penjualan_program.id; invoice_peserta.id_quotation_peserta → quotation_peserta.id. Diperiksa dalam transaksi, bukan FK fisik.&lt;br&gt;• id_penjualan dipakai persis skema fisik, menggantikan proposal id_penjualan_program.&lt;br&gt;• master_customer.perlakuan_ppn ENUM(PKP,WAPU,KB) NULL tanpa backfill. NULL lama wajib dilengkapi; default PKP hanya form baru.&lt;br&gt;• coa_master.id PK signed; no_perkiraan INDEX non-unique. Tidak membuat akun COA contoh." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="930" width="460" height="500" as="geometry" /></mxCell><mxCell id="inv4_note_invoice" value="&lt;b&gt;Constraint dan snapshot&lt;/b&gt;&lt;br&gt;• invoice.so_aktif = CASE WHEN status = 'invoiced' THEN id_sales_order ELSE NULL END, STORED dan UNIQUE: satu Invoice aktif/SO.&lt;br&gt;• UNIQUE invoice.nomor; invoice_peserta(id_invoice,id_quotation_peserta); invoice_jurnal(id_invoice,jenis,urutan); invoice_bukti_setor.id_invoice.&lt;br&gt;• Snapshot JSON invoice memuat SO/quotation/program/customer/peserta/harga/COA. Cetak tidak membaca master yang sudah berubah.&lt;br&gt;• Bayar sekali: tanggal_bayar/keterangan_bayar/bayar_by/bayar_date; tanpa jurnal kas. Bukti setor WAPU sekali, jurnal jenis bukti_setor.&lt;br&gt;• Status Invoiced SO diturunkan dari Invoice aktif; tidak menambah kolom status SO.&lt;br&gt;• Empat kolom audit digambar eksplisit, aktor login sah. Update old/new/detail_changes sesuai kontrak write_log().&lt;br&gt;• Fase 5: Invoice belum lunas Batal saat diproses keluar/reschedule; batal_by/date/alasan merekam aktor users.id_user. Snapshot, jurnal dan nilai historis tidak ditulis ulang. Invoice baru ditahan sampai seluruh Deal terdampak tuntas. Refund terpisah; transfer/pembalikan jurnal manual. Cicilan dan jurnal kas tetap di luar lingkup." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="950" width="520" height="480" as="geometry" /></mxCell><mxCell id="inv4_rel_so" edge="1" parent="1" source="inv4_sales_order_id" target="inv4_invoice_id_sales_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="143" /><mxPoint x="540" y="221" /></Array></mxGeometry></mxCell><mxCell id="inv4_rel_coa_invoice" edge="1" parent="1" source="inv4_coa_master_id" target="inv4_invoice_coa_penjualan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERm