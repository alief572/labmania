        <mxCell id="combine_a1" edge="1" parent="1" source="combine_attr" target="combine_u1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=1 4;endArrow=open;startArrow=none;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
