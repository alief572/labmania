  </diagram><diagram id="level1-activity-log" name="Level 1 — Activity Log">
    <mxGraphModel dx="1140" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="520" math="0" shadow="0">
      <root>
