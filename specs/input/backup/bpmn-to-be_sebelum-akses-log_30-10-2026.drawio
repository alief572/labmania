        <mxCell id="combine_a1" edge="1" parent="1" source="combine_attr" target="combine_u1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=1 4;endArrow=open;startArrow=none;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="combine_a2" edge="1" parent="1" source="combine_u2" target="combine_paket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=1 4;endArrow=open;startArrow=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="combine_note" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;spacing=8;" value="&lt;b&gt;Catatan:&lt;/b&gt; semua langkah dijalankan Manajemen di ERP (User task). Saat simpan, sistem memvalidasi field wajib &amp;amp; keunikan kombinasi (FR-22), lalu menyimpan 1 paket per baris dalam 1 transaksi dengan Nomor otomatis, status Aktif, dan write_log. Satu baris kombinasi = Produk, Bidang, Sertifikat (Varian dihapus 29-10-2026). Hanya atribut berstatus Aktif yang dapat dipilih (FR-21). Satu kali simpan dengan n baris menghasilkan n Paket Produk (FR-13); gagal satu baris = tidak ada paket yang tersimpan (NFR-03). Kombinasi ditolak bila ketiga atributnya sama persis dengan paket lain atau baris lain (FR-22; apakah paket nonaktif ikut dicek masih Q-17). Pemeliharaan master atribut (UC-01 – UC-04) di luar diagram ini." vertex="1"><mxGeometry x="40" y="510" width="860" height="100" as="geometry" /></mxCell>
