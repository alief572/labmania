        <mxCell id="pb_pic" parent="1" style="swimlane;html=1;startSize=20;horizontal=0;whiteSpace=wrap;" value="Tim Program (Sales, Trainer, Manajemen)" vertex="1"><mxGeometry x="40" y="70" width="1320" height="320" as="geometry" /></mxCell>
