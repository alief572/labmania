APP_NAME=Labmania
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=labmania_laravel
DB_USERNAME=labmania_laravel
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SESSION_COOKIE=labmania_laravel_session
LEGACY_DOCUMENT_ROOT=
AUDIT_RETENTION_ENABLED=false
ACTIVITY_LOG_ROLE_IDS=

# Bila nomor COA punya lebih dari satu baris, pilih PK akun yang sah.
INVOICE_COA_PIUTANG_ID=
INVOICE_COA_PPN_DN_ID=
INVOICE_COA_PUBLIC_ID=
INVOICE_COA_B2B_ID=
INVOICE_COA_UANG_MUKA_WAPU_ID=
INVOICE_COA_HUTANG_WAPU_ID=
INVOICE_BANK=
INVOICE_REKENING=
INVOICE_ATAS_NAMA=
INVOICE_PENANDA_TANGAN=
INVOICE_JABATAN=
INVOICE_KOTA=Bekasi
INVOICE_KODE_DOKUMEN=FR/LMI-FN-01/01

# Folder Times New Roman berlisensi (times.ttf dan timesbd.ttf) untuk Name Table.
PARTICIPANT_FONT_DIR=C:/Windows/Fonts
