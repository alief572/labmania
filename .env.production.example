# Template environment production Docker (compose.production.yaml).
# Salin ke .env.production di server: (umask 077; cp .env.production.example .env.production)
# Ganti semua nilai GANTI_*. Jangan commit .env.production atau kirim ke chat.
# Secret dikutip tunggal agar karakter $ tidak diinterpolasi.
# Periksa hasilnya dengan scripts/preflight-production.sh.
#
# Dipaksa oleh Compose (tidak bisa diubah di sini): APP_ENV=production,
# APP_DEBUG=false, DB_HOST=host.docker.internal, SESSION_*, TRUSTED_PROXIES,
# QUEUE/CACHE/LOG driver, LOCAL_UAT_ENABLED=false.

# --- Aplikasi ---
# Pertahankan APP_KEY instalasi Laravel asal bila membawa data existing.
APP_KEY='GANTI_APP_KEY_ASAL'
APP_URL=https://apps.sendigs.com/labmania

# --- Database Laravel (MySQL di host Ubuntu, database terpisah dari CI3/GL) ---
DB_PORT=3306
DB_DATABASE=GANTI_NAMA_DATABASE_LARAVEL
DB_USERNAME=GANTI_AKUN_KHUSUS_LARAVEL
DB_PASSWORD='GANTI_PASSWORD_DATABASE'

# --- Path di host (harus sudah ada; Compose tidak membuatnya) ---
PRODUCTION_HTTP_PORT=8081
PRODUCTION_STORAGE_DIR=/srv/labmania/storage
PRODUCTION_FONT_DIR=/srv/labmania/fonts

# --- COA read-only dari GL (akun SELECT-only) ---
# Bila GL ada di MySQL host yang sama, host-nya host.docker.internal, bukan 127.0.0.1.
COA_DB_CONNECTION=gl
COA_DB_HOST=host.docker.internal
COA_DB_PORT=3306
COA_DB_DATABASE=gl_labmania
COA_DB_USERNAME=laravel_gl_reader
COA_DB_PASSWORD='GANTI_PASSWORD_GL_READER'
COA_MYSQL_SSL_CA=

# --- Finance dan cetak invoice ---
# Nilai kosong menahan operasi terkait. Jangan memalsukan akun, identitas atau rekening;
# isi hanya dengan nilai yang sudah disahkan. Verifikasi PK akun terhadap GL tujuan.
INVOICE_COA_PIUTANG_ID=
INVOICE_COA_PPN_DN_ID=
INVOICE_COA_PUBLIC_ID=
INVOICE_COA_B2B_ID=
INVOICE_COA_UANG_MUKA_WAPU_ID=
INVOICE_COA_HUTANG_WAPU_ID=
INVOICE_BANK=
INVOICE_REKENING=
INVOICE_ATAS_NAMA=
INVOICE_PENANDA_TANGAN=
INVOICE_JABATAN=
INVOICE_KOTA=Bekasi
INVOICE_KODE_DOKUMEN=FR/LMI-FN-01/01

# --- Opsional ---
ACTIVITY_LOG_ROLE_IDS=
